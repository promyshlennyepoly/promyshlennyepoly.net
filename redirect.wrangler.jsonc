{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promyshlennyepoly-net",
  "main": "redirect-worker.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "promyshlennyepoly.net",
      "custom_domain": true
    },
    {
      "pattern": "www.promyshlennyepoly.net",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
